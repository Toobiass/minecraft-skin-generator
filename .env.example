# Copy to .env and adjust. Everything is optional - without .env the repo paths are used.
# Real environment variables take precedence over this file.
# Relative paths are resolved against the repo folder.

# 64x64 RGBA skins, one PNG per skin: <id>.png
SKIN_DIR=./data/skins
# Tag file, format see data/README.md
TAGS_JSON=./data/tags.json
# Checkpoints, metrics.csv, previews
RUNS_DIR=./runs
# Output of generate.py
OUT_DIR=./out
